# ValidationKit environment template.
#
# Two contexts:
#   1. Local-dev — copy this file to .env.local at repo root; pnpm dev picks it up.
#      All values below default to the Docker stack from docker-compose.yml.
#   2. Production (Vercel) — Vercel's project settings hold these as encrypted vars.
#      Don't commit production keys; this file is for shape + naming only.
#
# Convention: optional/Phase-N keys are commented out. Required-for-prod keys
# are uncommented with placeholder values.

# -------------------------------------------------------------------------- #
#  Required for any deploy (local OR prod)
# -------------------------------------------------------------------------- #

# Postgres. Local: docker-compose. Prod: Neon project connection string.
DATABASE_URL="postgres://vk:vk_local@127.0.0.1:5432/validationkit"

# Better-Auth session secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-base64-string"
AUTH_BASE_URL="http://localhost:3000"

# Public-facing URL used in checkout success/cancel redirects + RSS feed self-link.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -------------------------------------------------------------------------- #
#  Email (magic-link)
# -------------------------------------------------------------------------- #

# Local: Mailpit at http://localhost:8025
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_FROM="auth@validationkit.local"

# Prod: Resend. Comment SMTP_* out and set RESEND_API_KEY instead.
# RESEND_API_KEY="re_xxx"
# RESEND_FROM="auth@validationkit.app"

# -------------------------------------------------------------------------- #
#  Cache (Phase 0 only; not load-bearing)
# -------------------------------------------------------------------------- #

REDIS_URL="redis://127.0.0.1:6379"

# -------------------------------------------------------------------------- #
#  Background workflows (Inngest)
# -------------------------------------------------------------------------- #

# Local dev server (docker-compose). Prod uses INNGEST_EVENT_KEY below.
INNGEST_BASE_URL="http://127.0.0.1:8288"

# Prod: comment INNGEST_BASE_URL and set:
# INNGEST_EVENT_KEY="evt_xxx"
# INNGEST_SIGNING_KEY="signkey-prod-xxx"

# -------------------------------------------------------------------------- #
#  Stripe (Phase 1 — Sprint 1.1 paperwork-track)
# -------------------------------------------------------------------------- #

# Required to flip the live checkout. Until set, /api/stripe/webhook returns
# 503 + the /billing buttons return a "Stripe not configured" error.
# STRIPE_SECRET_KEY="sk_test_xxx"    # or sk_live_xxx after KYC
# STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Per-tier × billing-cycle Price IDs. Convention:
#   STRIPE_PRICE_<TIER>_<MONTHLY|ANNUAL>
# Set both for each tier you want self-serve checkout on. agency_scale_plus
# is annual-only — only set the ANNUAL var.
# STRIPE_PRICE_SOLO_INDIE_MONTHLY="price_xxx"
# STRIPE_PRICE_SOLO_INDIE_ANNUAL="price_xxx"
# STRIPE_PRICE_SOLO_PRO_MONTHLY="price_xxx"
# STRIPE_PRICE_SOLO_PRO_ANNUAL="price_xxx"
# STRIPE_PRICE_AGENCY_PRO_MONTHLY="price_xxx"
# STRIPE_PRICE_AGENCY_PRO_ANNUAL="price_xxx"
# STRIPE_PRICE_AGENCY_SCALE_MONTHLY="price_xxx"
# STRIPE_PRICE_AGENCY_SCALE_ANNUAL="price_xxx"
# STRIPE_PRICE_AGENCY_SCALE_PLUS_ANNUAL="price_xxx"   # annual-only

# Backwards-compat: STRIPE_PRICE_<TIER> with no suffix maps to monthly.

# -------------------------------------------------------------------------- #
#  LLM providers (Phase 1 — opt-in; LLM audit-rule + context-bloat fix)
# -------------------------------------------------------------------------- #

# Primary. claude-sonnet-4-6.
# ANTHROPIC_API_KEY="sk-ant-xxx"

# Cost-floor fallback. selectModel() picks Anthropic first; falls back to
# OpenAI (gpt-5-nano) if only OPENAI_API_KEY is set.
# OPENAI_API_KEY="sk-xxx"

# -------------------------------------------------------------------------- #
#  GitHub App (Phase 1 — Sprint 1.4 paperwork-track)
# -------------------------------------------------------------------------- #

# Until App-ID is registered, install-webhook returns 503. The manifest in
# @vk/github-app is pinned to read-only-default; live registration enforces it
# on the github.com side.
# GITHUB_APP_ID="1234567"
# GITHUB_APP_CLIENT_ID="Iv23xxxxxxxxxxxxxxxx"
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_WEBHOOK_SECRET="hex32"
# GITHUB_APP_INSTALL_URL="https://github.com/apps/validationkit/installations/new"

# -------------------------------------------------------------------------- #
#  Trust + compliance cosmetic
# -------------------------------------------------------------------------- #

# Optional: surface CCA-cert progress on /trust. Values: pending | in-progress | certified.
# CCA_STATUS="pending"
