# Local stack defaults — copy to .env and tweak only if you change docker-compose.yml.

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgres://vk:vk_local@127.0.0.1:5432/validationkit"

# Mailpit SMTP for Better-Auth magic links (UI: http://localhost:8025)
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_FROM="auth@validationkit.local"

# Dragonfly cache (Redis-compatible)
REDIS_URL="redis://127.0.0.1:6379"

# Inngest dev server
INNGEST_BASE_URL="http://127.0.0.1:8288"

# Better-Auth session secret — generate with `openssl rand -base64 32`
AUTH_SECRET="replace-me-with-a-32-byte-base64-string"
AUTH_BASE_URL="http://localhost:3000"

# Optional: LLM-Audit (Sprint 0.3 conflicting-rules). Leave unset for no-op.
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional: GitHub App (Sprint 0.6). Leave unset to keep LocalGitClient only.
# See docs/setup/github-app.md.
# GITHUB_APP_ID="1234567"
# GITHUB_APP_CLIENT_ID="Iv23xxxxxxxxxxxxxxxx"
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_WEBHOOK_SECRET="hex32"
# GITHUB_APP_INSTALL_URL="https://github.com/apps/validationkit/installations/new"
