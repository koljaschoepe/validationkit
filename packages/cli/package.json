{
  "name": "validationkit-cli",
  "version": "0.1.0",
  "description": "Cross-vendor agent-file audit + drift detection. Reads CLAUDE.md, AGENTS.md, .cursor/rules, .windsurfrules, .clinerules, .aider.conf.yml, SKILL.md and 5 more vendor formats. Deterministic 5/6 rules, no LLM hallucinations in the audit core.",
  "license": "MIT",
  "author": "Kolja Schöpe <kol.schoepe@gmail.com>",
  "homepage": "https://validationkit.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koljaschoepe/validationkit.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/koljaschoepe/validationkit/issues",
  "keywords": [
    "agents.md",
    "claude",
    "cursor",
    "windsurf",
    "cline",
    "aider",
    "agent-files",
    "audit",
    "drift",
    "ai-agent",
    "developer-tools",
    "cli",
    "cross-vendor"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "validationkit": "./bin/validationkit.mjs"
  },
  "files": ["dist", "bin", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@vk/core": "workspace:*",
    "@vk/parser": "workspace:*",
    "@vk/audit": "workspace:*",
    "@vk/drift": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
