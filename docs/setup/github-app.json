{
  "name": "ValidationKit",
  "url": "https://validationkit.local",
  "hook_attributes": {
    "url": "https://YOUR-TUNNEL.ngrok.app/api/install-webhook",
    "active": true
  },
  "redirect_url": "http://localhost:3000/api/auth/github/callback",
  "setup_url": "http://localhost:3000/requests",
  "setup_on_update": true,
  "callback_urls": [
    "http://localhost:3000/api/auth/github/callback"
  ],
  "request_oauth_on_install": false,
  "public": false,
  "default_events": [
    "installation",
    "installation_repositories"
  ],
  "default_permissions": {
    "contents": "read",
    "pull_requests": "read",
    "metadata": "read"
  },
  "description": "Cross-vendor agent-file trust. Read-only by default; per-repo Customer-Admin approval required for write scope. See docs/legal/scope-policy.md."
}
