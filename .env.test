# Test-Mode env-vars. Loaded by vitest setupFiles via dotenv/config.
# These are intentionally NON-secret placeholder values — checked into git
# so CI + new contributors get a working test-env without setup.

# Test-Postgres. Local: docker-compose vk-postgres + `validationkit_test` DB
# (creates per `pnpm db:migrate` on first run). CI: github-actions
# `services: postgres` exposes the same DSN.
DATABASE_URL="postgres://vk:vk_local@127.0.0.1:5432/validationkit_test"

# Auth — Better-Auth requires a 32-byte base64 secret to start.
AUTH_SECRET="dGVzdC1hdXRoLXNlY3JldC1mb3ItbmRkLXRlc3RpbmctMzJiYg=="
AUTH_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe — sk_test_dummy is intercepted by msw before it leaves the process.
# STRIPE_WEBHOOK_SECRET drives the constructEvent signature; tests sign
# their payloads with the same value.
STRIPE_SECRET_KEY="sk_test_dummy_for_tests"
STRIPE_WEBHOOK_SECRET="whsec_test_secret_for_signing_payloads"

# AI providers — empty by default so LLM-routes hit Hardcore-Local-Only mode
# (returns empty array, doesn't call out). Set explicitly in suites that
# exercise LLM-paths via msw handler stubs.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Inngest — local dev server. msw intercepts the network calls.
INNGEST_BASE_URL="http://127.0.0.1:8288"

# Mailpit. Tests that read the mailbox call its API directly.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_FROM="auth@validationkit.local"
